# Copy this file to .env and fill in your values

# Backend API URL (used by axios in api.js and apiService.js)
REACT_APP_API_URL=http://localhost:5000/api

# Backend Socket.IO URL (used by SocketContext.js)
REACT_APP_SOCKET_URL=http://localhost:5000

# Base URL for static assets (images, files, documents) - can point to S3 bucket
REACT_APP_ASSET_URL=http://localhost:5000


